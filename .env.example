# DeepfakeShield for PayPal — Production Environment Template
# NEVER commit production keys, passwords, or tokens to version control.

# PostgreSQL 18 Connection
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=deepfakeshield_db
PGUSER=postgres
PGPASSWORD=<STRONG_POSTGRES_ADMIN_PASSWORD>

# Role Database Passwords
APP_PASSWORD=<STRONG_APP_ROLE_PASSWORD>
VERIFIER_PASSWORD=<STRONG_VERIFIER_ROLE_PASSWORD>
WORKER_PASSWORD=<STRONG_WORKER_ROLE_PASSWORD>
AUDITOR_PASSWORD=<STRONG_AUDITOR_ROLE_PASSWORD>

# Cryptographic Enforcement & Secrets (Loaded from Cloud KMS / HSM)
STRICT_CRYPTO_ENFORCEMENT=true
ATTESTATION_SECRET=<64_HEX_CHARACTERS_32_BYTE_KMS_KEY>
BLIND_INDEX_KEY=<64_HEX_CHARACTERS_32_BYTE_KMS_KEY>
AUTH_ASSERTION_KEY=<64_HEX_CHARACTERS_32_BYTE_KMS_KEY>

# PayPal Developer Sandbox Payouts API Configuration
# Valid PAYPAL_PROVIDER_MODE values: SANDBOX_API | SIMULATOR
PAYPAL_PROVIDER_MODE=SANDBOX_API
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional Demo Operator Passwords (Override defaults in local testing)
ALICE_PASSWORD=<STRONG_MAKER_PASSWORD>
BOB_PASSWORD=<STRONG_OFFICER1_PASSWORD>
CAROL_PASSWORD=<STRONG_OFFICER2_PASSWORD>
DAVE_PASSWORD=<STRONG_AUDITOR_PASSWORD>
EVE_PASSWORD=<STRONG_CLERK_PASSWORD>

# V10.1.5 Explicit RISK_REVIEWER Provisioning (Never hardcoded; provision a real users row + scrypt hash)
# RISK_REVIEWER_USERNAME=
# RISK_REVIEWER_PASSWORD_HASH=scrypt:16384:8:1$<SALT_HEX>$<DERIVED_HEX>
# Or JSON map for multiple explicit reviewer accounts:
# RISK_REVIEWER_CREDENTIALS={"<reviewer_username>":"scrypt:16384:8:1$<SALT_HEX>$<DERIVED_HEX>"}
